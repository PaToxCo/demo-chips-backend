# --- Obligatorio ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Twilio (no se usan aún en el código, pero útiles si agregas llamadas salientes) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# --- Opcionales (tienen valor por defecto) ---
# Modelo Realtime de OpenAI (por defecto: gpt-realtime-2.1)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
# Voz de la IA: alloy, ash, ballad, coral, echo, sage, shimmer, verse, marin, cedar
# OpenAI recomienda marin o cedar (son las de mejor calidad)
AI_VOICE=alloy
# 1 = la IA saluda primero; 0 = espera a que hable el cliente
AI_SPEAKS_FIRST=1
# 1 = imprime TODOS los eventos de OpenAI en los logs (para depurar)
DEBUG_EVENTS=0
